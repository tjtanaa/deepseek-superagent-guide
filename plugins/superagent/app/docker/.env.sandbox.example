# Copy to .env.sandbox, chmod 600, fill in. Never commit it.
# The bot account's classic token, scopes repo + workflow only.
GH_TOKEN=
# The agent's GitHub login and its numeric id (for the no-reply email).
BOT_LOGIN=
BOT_ID=
# Repository the agent works on, OWNER/REPO.
REPO=

# Claude Code workers and the Opus router: an API key with a spend limit,
# or CLAUDE_CODE_OAUTH_TOKEN from `claude setup-token` (your subscription).
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# Codex workers: an API key, or leave empty and run
#   docker compose exec superagent codex login --device-auth
# once to use your ChatGPT plan (the login is kept in the data volume).
OPENAI_API_KEY=
